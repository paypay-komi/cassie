// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
    provider = "prisma-client"
    output   = "../generated/prisma"
}

datasource db {
    provider = "postgresql"
}

model UserGlobalCommandStats {
    id          String   @id @default(cuid())
    // @userid
    userId      String
    commandName String
    count       Int      @default(0)
    lastUsed    DateTime @default(now())

    @@unique([userId, commandName])
    @@index([userId])
}

// ------------------------------------------------------
// Global Guild Settings Object
// ------------------------------------------------------
model GuildSettingsObject {
    id   String @id @default("guild_settings")
    data Json
}

// ------------------------------------------------------
// Global User Data Object
// ------------------------------------------------------
model UserDataObject {
    id   String @id @default("user_data")
    data Json
}

model todolist {
    id        String   @id @default(cuid())
    // @userid
    userId    String
    content   String
    createdAt DateTime @default(now())
    completed Boolean  @default(false)

    @@index([userId])
}

model reminder {
    id              String   @id @default(cuid())
    // @userid
    userId          String
    content         String
    remindAt        DateTime
    createdAt       DateTime @default(now())
    repeatingSecs   Int? // if set, this is the interval for repeating reminders
    remindInChannel Boolean  @default(false) // if true, reminder will be sent in the channel instead of DM
    channelId       String? // if remindInChannel is true, this is the ID of the channel to send the reminder in

    @@index([userId])
}

// ------------------------------------------------------
// Guild-Level Settings
// ------------------------------------------------------
model GuildSettings {
    guildId String    @id
    prefix  String    @default("c.")
    leftAt  DateTime?

    channels             ChannelSettings[]
    userSettings         GuildUserSettings[]
    disabledCommands     GuildDisabledCommand[]
    channelCommandAccess GuildChannelCommandAccess[]
    roleCommandAccess    GuildRoleCommandAccess[]
    userCommandAccess    GuildUserCommandAccess[]
    tags                 GuildTag[]
    echoChannels         EchoChannel[]
    announcement         GuildAnnouncement?
}

model UserPrefix {
    // @userid
    userId String @id
    prefix String
}

model GuildTag {
    id            String        @id @default(cuid())
    guildId       String
    name          String
    content       String
    // @userid
    creatorId     String
    uses          Int           @default(0)
    createdAt     DateTime      @default(now())
    updatedAt     DateTime      @updatedAt
    guildSettings GuildSettings @relation(fields: [guildId], references: [guildId], onDelete: Cascade)

    @@unique([guildId, name])
    @@index([guildId])
}

model ChatMessage {
    id        String   @id @default(cuid())
    // @userid
    userId    String
    guildId   String?
    channelId String?
    role      String
    content   String
    createdAt DateTime @default(now())

    @@index([userId, createdAt])
}

model GlobalAfkUser {
    // @userid
    userId String   @id
    reason String?
    since  DateTime @default(now())

    // Optional enhancements
    autoReply    Boolean @default(true)
    ignoreBots   Boolean @default(true)
    notifyOnPing Boolean @default(true)

    mentionCount Int @default(0)

    mentions GlobalAfkMention[]

    updatedAt DateTime @updatedAt
}

model userTimezone {
    // @userid
    userId         String   @id
    minsOffset     Int      @default(0)
    timeZoneString String?  @default("NONE")
    timeFormat     String?  @default("12H")
    createdAt      DateTime @default(now())
    updatedAt      DateTime @updatedAt
}

model GlobalAfkMention {
    id          String   @id @default(cuid())
    // @userid
    userId      String
    guildId     String
    channelId   String
    messageId   String
    // @userid
    mentionedBy String
    createdAt   DateTime @default(now())

    afkUser GlobalAfkUser @relation(fields: [userId], references: [userId], onDelete: Cascade)

    @@index([userId])
}

// ------------------------------------------------------
// Channel-Level Settings (per guild)
// ------------------------------------------------------
model ChannelSettings {
    id        Int    @id @default(autoincrement())
    channelId String

    guild   GuildSettings @relation(fields: [guildId], references: [guildId], onDelete: Cascade)
    guildId String
}

// ------------------------------------------------------
// Per-User Settings (per guild)
// ------------------------------------------------------
model GuildUserSettings {
    id      Int    @id @default(autoincrement())
    guildId String
    // @userid
    userId  String

    statTracking Boolean @default(true)

    guild GuildSettings @relation(fields: [guildId], references: [guildId], onDelete: Cascade)

    @@unique([guildId, userId])
    @@index([guildId])
    @@index([userId])
}

// ------------------------------------------------------
// Per-User Per-Command Stats (per guild or "dm")
// ------------------------------------------------------
model UserCommandStats {
    id          String   @id @default(cuid())
    // @userid
    userId      String
    guildId     String // use "dm" for direct messages
    commandName String
    count       Int      @default(0)
    lastUsed    DateTime @default(now())

    @@unique([userId, guildId, commandName])
    @@index([guildId])
    @@index([userId])
}

// ------------------------------------------------------
// Global Stats Container (ONE ROW ONLY)
// ------------------------------------------------------
model GlobalStats {
    id       String               @id @default("global")
    commands GlobalCommandStats[]
}

// ------------------------------------------------------
// Global Command Stats (children of GlobalStats)
// ------------------------------------------------------
model GlobalCommandStats {
    id          String   @id @default(cuid())
    commandName String
    count       Int      @default(0)
    lastUsed    DateTime @default(now())

    globalStats   GlobalStats @relation(fields: [globalStatsId], references: [id])
    globalStatsId String

    @@unique([globalStatsId, commandName])
}

model Idea {
    id       String @id @default(cuid())
    // @userid
    authorId String
    content  String
    status   String @default("pending") // "pending" | "approved" | "rejected"

    // moderation
    // @userid
    rejectedBy   String?
    rejectedAt   DateTime?
    rejectReason String?
    // @userid
    approvedBy   String?
    approvedAt   DateTime?

    // ai analysis
    aiResult       String? // "approved" | "pending" | "rejected"
    aiReason       String?
    aiThoughts     String?
    aiConfidence   Float?
    aiCategory     String? // "moderation" | "fun" | "economy" | "utility" | "music" | "info" | "other"
    aiImprovedIdea String?
    aiDuplicateOf  String?

    createdAt  DateTime   @default(now())
    vote_score Int        @default(0)
    votes      IdeaVote[]
}

model UserVoteStats {
    // @userid
    userId            String    @id
    lastVote          DateTime?
    totalVotes        Int       @default(0)
    voteStreak        Int       @default(0)
    bestStreak        Int       @default(0)
    lastClaimedReward DateTime?
    voteDmOptOut      Boolean   @default(false)
    updatedAt         DateTime  @updatedAt
}

model IdeaVote {
    id        String   @id @default(cuid())
    ideaId    String
    // @userid
    userId    String
    value     Int // 1 = upvote, -1 = downvote
    createdAt DateTime @default(now())
    idea      Idea     @relation(fields: [ideaId], references: [id], onDelete: Cascade)

    @@unique([ideaId, userId])
    @@index([ideaId])
    @@index([userId])
}

model DblVote {
    // @userid
    userId            String    @id
    lastVote          DateTime?
    totalVotes        Int       @default(0)
    voteStreak        Int       @default(0)
    bestStreak        Int       @default(0)
    lastClaimedReward DateTime?
    updatedAt         DateTime  @updatedAt
}

model CourtCase {
    id String @id @default(cuid())

    guildId      String
    // @userid
    defendantId  String
    // @userid
    prosecutorId String

    channelId String
    messageId String? @unique
    threadId  String?

    reason String

    status CourtStatus @default(VOTING)

    voteDeadline DateTime?

    createdAt DateTime  @default(now())
    updatedAt DateTime  @updatedAt
    closedAt  DateTime?

    votes CourtVote[]
}

model CourtVote {
    id String @id @default(cuid())

    caseId  String
    // @userid
    voterId String

    /// 1 = guilty, -1 = not guilty
    value Int

    votedAt   DateTime @default(now())
    updatedAt DateTime @updatedAt

    courtCase CourtCase @relation(fields: [caseId], references: [id], onDelete: Cascade)

    @@unique([caseId, voterId])
    @@index([voterId])
}

// ------------------------------------------------------
// Command Access Control (replaces old JSON blobs)
// ------------------------------------------------------

// Guild-wide disabled command (no one can use it without an allow override)
model GuildDisabledCommand {
    id        String @id @default(cuid())
    guildId   String
    commandId String

    guild GuildSettings @relation(fields: [guildId], references: [guildId], onDelete: Cascade)

    @@unique([guildId, commandId])
    @@index([guildId])
}

// Channel-level command access (allow/deny override)
model GuildChannelCommandAccess {
    id        String  @id @default(cuid())
    guildId   String
    channelId String
    commandId String
    allowed   Boolean @default(false) // true = allow override, false = deny

    guild GuildSettings @relation(fields: [guildId], references: [guildId], onDelete: Cascade)

    @@unique([channelId, commandId])
    @@index([guildId])
    @@index([channelId])
}

// Per-role command access (allow = bypass guild/channel disable, deny = block regardless)
model GuildRoleCommandAccess {
    id        String  @id @default(cuid())
    guildId   String
    roleId    String
    commandId String
    allowed   Boolean // true = allowed (bypasses guild/channel disable), false = denied

    guild GuildSettings @relation(fields: [guildId], references: [guildId], onDelete: Cascade)

    @@unique([guildId, roleId, commandId])
    @@index([guildId])
    @@index([roleId])
}

// Per-user command access (allow = bypass everything, deny = block regardless)
model GuildUserCommandAccess {
    id        String  @id @default(cuid())
    guildId   String
    // @userid
    userId    String
    commandId String
    allowed   Boolean // true = allowed (bypasses guild/channel/role disable), false = denied

    guild GuildSettings @relation(fields: [guildId], references: [guildId], onDelete: Cascade)

    @@unique([guildId, userId, commandId])
    @@index([guildId])
    @@index([userId])
}

enum CourtStatus {
    VOTING
    GUILTY
    NOT_GUILTY
    DISMISSED
}

model EchoChannel {
    id             String @id @default(cuid())
    guildId        String
    channelId      String @unique
    webhookId      String
    webhookToken   String
    echoChance     Float? @default(85)
    deleteDelayMin Int?   @default(10000)
    deleteDelayMax Int?   @default(300000)
    echoDelayMin   Int?   @default(0)
    echoDelayMax   Int?   @default(86400000)

    createdAt DateTime @default(now())

    messages EchoMessage[]
    guild    GuildSettings @relation(fields: [guildId], references: [guildId], onDelete: Cascade)

    @@unique([channelId, guildId])
    @@index([guildId])
}

model EchoMessage {
    id                String    @id @default(cuid())
    guildId           String
    channelId         String
    // @userid
    authorId          String
    content           String
    deliverAt         DateTime
    deliveredAt       DateTime?
    createdAt         DateTime  @default(now())
    originalMessageId String?
    attachments       Json?
    poll              Json?
    embeds            Json?

    channel EchoChannel @relation(fields: [channelId, guildId], references: [channelId, guildId], onDelete: Cascade)

    @@index([deliverAt])
    @@index([channelId, deliverAt])
}

model TimeCapsule {
    id        String    @id @default(cuid())
    // @userid
    userId    String
    content   String
    sendAt    DateTime
    sentAt    DateTime?
    createdAt DateTime  @default(now())

    @@index([sendAt])
    @@index([userId, sendAt])
}

model Session {
    id  String @id @default(cuid())
    sid String @unique

    data      String
    expiresAt DateTime

    createdAt DateTime @default(now())
}

model GuildAnnouncement {
    guildId      String    @id
    channelId    String? // set = subscribed, null = not yet set or unsubscribed
    webhookId    String? // webhook for sending broadcast announcements
    webhookToken String? // webhook token
    optedOut     Boolean   @default(false) // true = user explicitly unsubscribed, stop nagging
    lastNagged   DateTime? // when we last nagged this guild, null = never nagged
    createdAt    DateTime  @default(now())
    updatedAt    DateTime  @updatedAt

    guild GuildSettings @relation(fields: [guildId], references: [guildId], onDelete: Cascade)
}

model InviteClick {
    id        Int       @id @default(autoincrement())
    state     String?   @unique
    ref       String    @default("unknown")
    ip        String?
    userAgent String?
    guildId   String?
    matchedAt DateTime?
    createdAt DateTime  @default(now())

    @@index([ref])
    @@index([guildId])
    @@index([createdAt])
    @@index([state])
}

model ReactionGif {
    id        String   @id @default(uuid())
    hash      String   @unique
    actions   String[]
    fileType  String
    mediaHash BigInt?
    createdAt DateTime @default(now())

    reports ReactionGifReport[]

    @@index([hash, actions])
    @@index([mediaHash])
}

model ReactionGifReport {
    gifId  String
    action String
    userId String

    gif ReactionGif @relation(fields: [gifId], references: [id], onDelete: Cascade)

    @@id([gifId, action, userId])
    @@index([action])
}

model SubmittedReactonGif {
    id          String    @id @default(uuid())
    actions     String[]
    hash        String    @unique
    fileType    String
    mediaHash   BigInt?
    createdAt   DateTime  @default(now())
    approvedAt  DateTime?
    pending     Boolean   @default(true)
    // @userid
    submittedBy String
    // @userid
    approvedBy  String?

    @@index([hash, actions])
    @@index([mediaHash])
}

// ------------------------------------------------------
// Economy System (bare bones — balance, daily, work, pay)
// ------------------------------------------------------

model GuildEconomy {
    guildId            String @id
    currencyName       String @default("Cass Bit")
    currencyNamePlural String @default("Cass Bits")
    currencySymbol     String @default("🐰")

    // Daily
    dailyBase        Int @default(100)
    dailyStreakBonus Int @default(25)
    dailyCap         Int @default(1000)
    streakResetDays  Int @default(1)

    // Work
    workMin                 Int @default(10)
    workMax                 Int @default(50)
    workCooldown            Int @default(60)
    workStreakBonus         Int @default(1)
    workStreakDecayInterval Int @default(1800)

    // Tax (% taken from transfers, 0–100, destroyed not collected)
    taxRate Int @default(0)

    // Economy channel lock (optional)
    economyChannel String?

    // Master toggle
    enabled Boolean @default(true)

    createdAt DateTime @default(now())
    updatedAt DateTime @updatedAt

    users GuildEconomyUser[]
}

model GuildEconomyUser {
    guildEconomy GuildEconomy @relation(fields: [guildId], references: [guildId], onDelete: Cascade)
    guildId      String
    // @userid
    userId       String

    balance     Int @default(0)
    totalEarned Int @default(0)
    totalSpent  Int @default(0)

    lastDaily DateTime?
    lastWork  DateTime?

    workStreak Int @default(0)
    streakDays Int @default(0)

    createdAt DateTime @default(now())
    updatedAt DateTime @updatedAt

    transactions GuildEconomyTransaction[]

    @@id([guildId, userId])
    @@index([guildId])
}

model GuildEconomyTransaction {
    id            String   @id @default(cuid())
    guildId       String
    // @userid
    userId        String
    type          String // daily | work | pay_in | pay_out | admin_add | admin_remove
    amount        Int // positive = gained, negative = lost
    balanceAfter  Int
    // @userid
    relatedUserId String?
    description   String?
    createdAt     DateTime @default(now())

    user GuildEconomyUser @relation(fields: [guildId, userId], references: [guildId, userId], onDelete: Cascade)

    @@index([guildId, userId])
    @@index([guildId, createdAt])
}

model GuildMemberActivity {
    guildId      String
    // @userid
    userId       String
    messageCount Int    @default(0)
    voiceSeconds Int    @default(0)

    @@id([guildId, userId])
}

model GuildMemberRoleRequirement {
    id         String @id @default(cuid())
    guildId    String
    roleId     String
    expression String
    ast        Json

    createdAt DateTime @default(now())
    updatedAt DateTime @updatedAt

    @@unique([guildId, roleId])
    @@index([guildId])
    @@index([roleId])
}

model VoteReminder {
	id        String   @id @default(cuid())
	// @userid
	userId    String
	remindAt  DateTime
	createdAt DateTime @default(now())
	site      String? // optional site hint
	@@index([remindAt])
	@@index([userId])
	@@unique([userId]) // one pending reminder per user (upsert)
}

// ------------------------------------------------------
// Persistent Chat Memory (~1000 words per user)
// The AI can read/write/append via tool calls
// ------------------------------------------------------
model ChatMemory {
	// @userid
	userId    String   @id
	memory    String   @default("") // free-text, ~1000 words max
	updatedAt DateTime @updatedAt
}

// ------------------------------------------------------
// Reaction Roles
// ------------------------------------------------------
model ReactionRole {
	id        String @id @default(cuid())
	guildId   String
	channelId String
	messageId String @unique
	// @userid
	creatorId String
	createdAt DateTime @default(now())
	updatedAt DateTime @updatedAt

	entries ReactionRoleEntry[]

	@@index([guildId])
	@@index([messageId])
}

model ReactionRoleEntry {
	id            String @id @default(cuid())
	reactionRoleId String
	emoji         String // custom: "name:id" or unicode: "👍"
	roleId        String

	reactionRole ReactionRole @relation(fields: [reactionRoleId], references: [id], onDelete: Cascade)

	@@unique([reactionRoleId, emoji])
	@@index([roleId])
}

// ------------------------------------------------------
// Boosts
// ------------------------------------------------------
model GuildBoostConfig {
	guildId   String   @id
	channelId String? // channel where boost thank-you messages go, null = not set
	roleId    String? // role applied to boosters, null = not set
	enabled   Boolean  @default(true)
	createdAt DateTime @default(now())
	updatedAt DateTime @updatedAt

	@@index([channelId])
	@@index([roleId])
}

model MemberBoostStreak {
	id          String    @id @default(cuid())
	guildId     String
	// @userid
	userId      String
	streak      Int       @default(0) // consecutive boosts within 30-day window
	totalBoosts Int       @default(0)
	lastBoostAt DateTime?
	createdAt   DateTime  @default(now())
	updatedAt   DateTime  @updatedAt

	@@unique([guildId, userId])
	@@index([guildId])
	@@index([userId])
}

// ------------------------------------------------------
// Invite Tracking
// ------------------------------------------------------
model GuildInviteConfig {
	guildId          String   @id
	channelId        String?  // where join announcements go
	message          String?  // custom welcome script
	deductOnLeave    Boolean  @default(true)
	fakeAccountDays  Int      @default(0) // accounts younger than this are "fake"
	trackingEnabled  Boolean  @default(true)
	createdAt        DateTime @default(now())
	updatedAt        DateTime @updatedAt

	@@index([channelId])
}

model Invite {
	id          String   @id @default(cuid())
	guildId     String
	code        String
	inviterId   String
	uses        Int      @default(0)
	maxUses     Int      @default(0)
	temporary   Boolean  @default(false)
	createdAt   DateTime @default(now())
	expiresAt   DateTime?

	@@unique([guildId, code])
	@@index([guildId, inviterId])
}

model InviteJoin {
	id        String   @id @default(cuid())
	guildId   String
	userId    String
	inviteId  String?  // null if couldn't determine (vanity, etc.)
	fake      Boolean  @default(false)
	joinedAt  DateTime @default(now())
	leftAt    DateTime?

	@@index([guildId, userId])
	@@index([guildId, inviteId])
}

model InviteBonus {
	id        String   @id @default(cuid())
	guildId   String
	roleId    String
	bonus     Int      @default(1) // extra invites per join

	@@unique([guildId, roleId])
}

model InviteAdjustment {
	id        String   @id @default(cuid())
	guildId   String
	userId    String
	amount    Int      @default(0)
	updatedAt DateTime @updatedAt

	@@unique([guildId, userId])
	@@index([guildId])
}

// ------------------------------------------------------
// Tickets
// ------------------------------------------------------
model TicketPanel {
	id          String   @id @default(cuid())
	guildId     String
	name        String
	channelId   String?  // where panel message is posted
	messageId   String?  // the panel message
	categoryId  String?  // default category for tickets
	maxOpen     Int      @default(1) // per user per panel
	mode        String   @default("thread") // "thread" or "channel"
	createdAt   DateTime @default(now())
	updatedAt   DateTime @updatedAt

	options     TicketOption[]
	tickets     Ticket[]

	@@unique([guildId, name])
	@@index([guildId])
}

model TicketOption {
	id          String   @id @default(cuid())
	panelId     String
	name        String   // internal key
	label       String   // button label
	style       Int      @default(1) // 1=primary, 2=secondary, 3=success, 4=danger
	emoji       String?  // optional emoji
	categoryId  String?  // override panel category
	formId      String?  // attached form
	closeOnLeave Boolean @default(false)
	supportRoles String[] @default([])

	panel       TicketPanel @relation(fields: [panelId], references: [id], onDelete: Cascade)
	tickets     Ticket[]

	@@unique([panelId, name])
	@@index([panelId])
}

model TicketForm {
	id        String   @id @default(cuid())
	guildId   String
	name      String
	title     String
	fields    TicketFormField[]

	@@unique([guildId, name])
	@@index([guildId])
}

model TicketFormField {
	id          String   @id @default(cuid())
	formId      String
	key         String   // unique within form
	type        String   // short_text, long_text, checkbox, select, role_select, user_select, channel_select, case_select
	label       String
	required    Boolean  @default(true)
	choices     String[] @default([]) // for select types
	placeholder String?
	order       Int      @default(0)

	form        TicketForm @relation(fields: [formId], references: [id], onDelete: Cascade)

	@@unique([formId, key])
	@@index([formId])
}

model Ticket {
	id          String   @id @default(cuid())
	guildId     String
	panelId     String?
	optionId    String?
	channelId   String
	threadId    String?  // if mode=thread
	ownerId     String
	claimedById String?
	status      String   @default("open") // open, claimed, closed, deleted
	priority    Int      @default(0) // 0=low, 1=medium, 2=high, 3=urgent
	subject     String?
	formData    Json?    // submitted form responses
	createdAt   DateTime @default(now())
	updatedAt   DateTime @updatedAt
	closedAt    DateTime?
	closedById  String?
	closeReason String?

	panel       TicketPanel?   @relation(fields: [panelId], references: [id], onDelete: SetNull)
	option      TicketOption?  @relation(fields: [optionId], references: [id], onDelete: SetNull)
	messages    TicketMessage[]
	notes       TicketNote[]

	@@index([guildId, ownerId])
	@@index([guildId, status])
	@@index([channelId])
}

model TicketMessage {
	id        String   @id @default(cuid())
	ticketId  String
	userId    String
	content   String
	createdAt DateTime @default(now())

	ticket    Ticket @relation(fields: [ticketId], references: [id], onDelete: Cascade)

	@@index([ticketId, createdAt])
}

model TicketNote {
	id        String   @id @default(cuid())
	ticketId  String
	userId    String
	content   String
	createdAt DateTime @default(now())

	ticket    Ticket @relation(fields: [ticketId], references: [id], onDelete: Cascade)

	@@index([ticketId, createdAt])
}

model SavedReply {
	id        String   @id @default(cuid())
	guildId   String
	name      String
	content   String
	createdAt DateTime @default(now())
	updatedAt DateTime @updatedAt

	@@unique([guildId, name])
	@@index([guildId])
}

// ------------------------------------------------------
// Starboard
// ------------------------------------------------------
model Starboard {
	id            String   @id @default(cuid())
	guildId       String
	channelId     String
	emoji         String   // unicode or "name:id"
	threshold     Int      @default(1)
	selfStar      Boolean  @default(false)
	showAttachments Boolean @default(true)
	showTimestamp Boolean  @default(true)
	jumpUrl       Boolean  @default(true)
	color         Int?     // embed color
	createdAt     DateTime @default(now())
	updatedAt     DateTime @updatedAt

	ignored       StarboardIgnore[]

	@@unique([guildId, emoji])
	@@index([guildId])
}

model StarboardIgnore {
	id        String   @id @default(cuid())
	starboardId String
	targetId  String   // channel, role, or member ID
	targetType String   // "channel", "role", "member"

	starboard Starboard @relation(fields: [starboardId], references: [id], onDelete: Cascade)

	@@unique([starboardId, targetId, targetType])
	@@index([starboardId])
}

model StarboardEntry {
	id                 String   @id @default(cuid())
	guildId            String
	starboardId        String
	sourceMessageId    String
	sourceChannelId    String
	starboardMessageId String
	starCount          Int      @default(0)
	createdAt          DateTime @default(now())
	updatedAt          DateTime @updatedAt

	@@unique([sourceMessageId, starboardId])
	@@index([guildId, sourceChannelId])
	@@index([guildId, starboardId])
}

// ------------------------------------------------------
// Levels / XP
// ------------------------------------------------------
model LevelConfig {
	guildId         String   @id
	channelId       String?  // level-up announcements
	textEnabled     Boolean  @default(true)
	voiceEnabled    Boolean  @default(true)
	textMultiplier  Float    @default(1.0)
	dmLevelUp       Boolean  @default(false)
	stackRoles      Boolean  @default(true)
	cardEnabled     Boolean  @default(false)
	cardBackground  String?  // URL
	cardBranding    Boolean  @default(true)
	decayEnabled    Boolean  @default(false)
	decayDays       Int      @default(30)
	decayPercent    Int      @default(10)
	createdAt       DateTime @default(now())
	updatedAt       DateTime @updatedAt

	@@index([channelId])
}

model LevelRoleReward {
	id        String   @id @default(cuid())
	guildId   String
	roleId    String
	level     Int

	@@unique([guildId, level])
	@@index([guildId])
}

model LevelMilestone {
	id        String   @id @default(cuid())
	guildId   String
	level     Int
	coins     Int      @default(0)
	roleId    String?

	@@unique([guildId, level])
	@@index([guildId])
}

model LevelMultiplier {
	id        String   @id @default(cuid())
	guildId   String
	targetId  String   // role or channel ID
	targetType String  // "role" or "channel"
	multiplier Float

	@@unique([guildId, targetId, targetType])
	@@index([guildId])
}

model LevelIgnore {
	id        String   @id @default(cuid())
	guildId   String
	targetId  String
	targetType String  // "channel" or "role"

	@@unique([guildId, targetId, targetType])
	@@index([guildId])
}

model MemberXP {
	id            String   @id @default(cuid())
	guildId       String
	userId        String
	xp            BigInt   @default(0)
	level         Int      @default(0)
	totalVoiceSec BigInt   @default(0)
	lastMessageAt DateTime?
	lastVoiceAt   DateTime?
	createdAt     DateTime @default(now())
	updatedAt     DateTime @updatedAt

	@@unique([guildId, userId])
	@@index([guildId, level])
	@@index([guildId, xp])
}

// ------------------------------------------------------
// VoiceMaster
// ------------------------------------------------------
model VoiceMasterConfig {
	guildId        String   @id
	categoryId     String?  // category for temp channels
	interfaceEnabled Boolean @default(true) // post control panel in temp channel
	defaultBitrate Int      @default(64)
	defaultName    String   @default("{user}'s channel")
	defaultRegion  String?  // "auto" or specific region
	defaultRoleId  String?  // role that can see/join by default
	temporary      Boolean  @default(true) // delete empty channels
	createdAt      DateTime @default(now())
	updatedAt      DateTime @updatedAt

	@@index([categoryId])
}

model VoiceMasterHub {
	id        String   @id @default(cuid())
	guildId   String
	channelId String   // the join-to-create voice channel
	name      String   // hub name
	createdAt DateTime @default(now())

	@@unique([guildId, channelId])
	@@index([guildId])
}

model VoiceChannel {
	id          String   @id @default(cuid())
	guildId     String
	channelId   String   @unique // the temp voice channel ID
	ownerId     String   // creator
	locked      Boolean  @default(false)
	hidden      Boolean  @default(false)
	userLimit   Int      @default(0)
	bitrate     Int      @default(64)
	name        String?
	region      String?
	createdAt   DateTime @default(now())
	updatedAt   DateTime @updatedAt

	members     VoiceChannelMember[]

	@@unique([guildId, channelId])
	@@index([guildId, ownerId])
}

model VoiceChannelMember {
	id         String   @id @default(cuid())
	channelId  String   // VoiceChannel.channelId
	userId     String
	permitted  Boolean  @default(true) // false = rejected/banned
	joinedAt   DateTime @default(now())

	channel    VoiceChannel @relation(fields: [channelId], references: [channelId], onDelete: Cascade)

	@@unique([channelId, userId])
	@@index([channelId])
}

// ------------------------------------------------------
// Automation: Antinuke
// ------------------------------------------------------
model AntinukeConfig {
	guildId       String   @id
	enabled       Boolean  @default(false)
	admins        String[] @default([]) // user IDs with AntiNuke Admin
	whitelisted   String[] @default([]) // user IDs whitelisted
	createdAt     DateTime @default(now())
	updatedAt     DateTime @updatedAt

	modules       AntinukeModule[]
}

model AntinukeModule {
	id           String   @id @default(cuid())
	configId     String
	type         String   // ban, channel, role, emoji, sticker, webhook, integration, invite, botadd, kick, guildupdate, soundboard, vanity
	enabled      Boolean  @default(false)
	punishment   String   @default("ban") // ban, kick, strip, timeout
	punishmentDuration Int? // for timeout
	logChannelId String?
	threshold    Int?     // e.g., max channels deleted before trigger
	window       Int?     // time window in seconds
	createdAt    DateTime @default(now())
	updatedAt    DateTime @updatedAt

	config       AntinukeConfig @relation(fields: [configId], references: [guildId], onDelete: Cascade)

	@@unique([configId, type])
	@@index([configId])
}

// ------------------------------------------------------
// Automation: Antiraid
// ------------------------------------------------------
model AntiraidConfig {
	guildId           String   @id
	enabled           Boolean  @default(false)
	whitelisted       String[] @default([])
	lockdown          Boolean  @default(false)
	createdAt         DateTime @default(now())
	updatedAt         DateTime @updatedAt

	modules           AntiraidModule[]
}

model AntiraidModule {
	id            String   @id @default(cuid())
	configId      String
	type          String   // age, avatar, massjoin, massmention, unverifiedbots, username
	enabled       Boolean  @default(false)
	action        String   @default("kick") // kick, ban
	threshold     Int?     // for massjoin/massmention
	window        Int?     // time window in seconds
	maxAgeDays    Int?     // for age module
	usernamePatterns String[] @default([]) // for username module
	createdAt     DateTime @default(now())
	updatedAt     DateTime @updatedAt

	config        AntiraidConfig @relation(fields: [configId], references: [guildId], onDelete: Cascade)

	@@unique([configId, type])
	@@index([configId])
}

// ------------------------------------------------------
// Automation: Automod
// ------------------------------------------------------
model AutomodConfig {
	guildId          String   @id
	enabled          Boolean  @default(false)
	logChannelId     String?
	punishment       String   @default("delete") // delete, warn, timeout, kick, ban
	punishmentDuration Int?   // for timeout
	strikesEnabled   Boolean  @default(false)
	maxStrikes       Int      @default(5)
	strikeDecayHours Int      @default(168) // 1 week
	createdAt        DateTime @default(now())
	updatedAt        DateTime @updatedAt

	filters          AutomodFilter[]
	regexes          AutomodRegex[]
	exemptions       AutomodExemption[]
	strikeConfig     AutomodStrikeConfig[]
}

model AutomodFilter {
	id             String   @id @default(cuid())
	configId       String
	type           String   // keyword, caps, emoji, images, invites, links, malicious, massmention, musicfiles, nicknames, nsfw, repetition, spam, spoilers, walloftext
	enabled        Boolean  @default(false)
	threshold      Int?     // e.g., % caps, count of emojis
	whitelisted    String[] @default([]) // words/URLs exempt
	blacklisted    String[] @default([]) // additional blocked terms
	punishment     String?  // override default
	punishmentDuration Int? // override
	createdAt      DateTime @default(now())
	updatedAt      DateTime @updatedAt

	config         AutomodConfig @relation(fields: [configId], references: [guildId], onDelete: Cascade)

	@@unique([configId, type])
	@@index([configId])
}

model AutomodRegex {
	id        String   @id @default(cuid())
	configId  String
	name      String
	pattern   String
	enabled   Boolean  @default(true)
	createdAt DateTime @default(now())

	config    AutomodConfig @relation(fields: [configId], references: [guildId], onDelete: Cascade)

	@@unique([configId, name])
	@@index([configId])
}

model AutomodExemption {
	id        String   @id @default(cuid())
	configId  String
	targetId  String   // role or channel ID
	targetType String   // "role" or "channel"
	createdAt DateTime @default(now())

	config    AutomodConfig @relation(fields: [configId], references: [guildId], onDelete: Cascade)

	@@unique([configId, targetId, targetType])
	@@index([configId])
}

model AutomodStrikeConfig {
	id        String   @id @default(cuid())
	configId  String
	strikes   Int      // threshold
	action    String   // warn, timeout, kick, ban, strip
	duration  Int?     // for timeout in seconds
	createdAt DateTime @default(now())

	config    AutomodConfig @relation(fields: [configId], references: [guildId], onDelete: Cascade)

	@@unique([configId, strikes])
	@@index([configId])
}

model MemberStrike {
	id        String   @id @default(cuid())
	guildId   String
	userId    String
	strikes   Int      @default(0)
	lastStrikeAt DateTime?
	createdAt DateTime @default(now())
	updatedAt DateTime @updatedAt

	@@unique([guildId, userId])
	@@index([guildId])
}

// ------------------------------------------------------
// Moderation: Invoke System & Escalation
// ------------------------------------------------------
model InvokeConfig {
	id          String   @id @default(cuid())
	guildId     String
	command     String   // ban, kick, timeout, warn, jail, etc.
	type        String   // "dm" or "message"
	content     String   // script/template
	createdAt   DateTime @default(now())
	updatedAt   DateTime @updatedAt

	@@unique([guildId, command, type])
	@@index([guildId])
}

model WarnPunishment {
	id        String   @id @default(cuid())
	guildId   String
	threshold Int      // warning count
	action    String   // timeout, kick, jail, hardban, softban, ban
	duration  Int?     // seconds for timeout
	createdAt DateTime @default(now())

	@@unique([guildId, threshold])
	@@index([guildId])
}

model JailConfig {
	guildId     String   @id
	enabled     Boolean  @default(false)
	roleId      String?  // the jailed role
	categoryId  String?  // category with jail channel
	logChannelId String?
	createdAt   DateTime @default(now())
	updatedAt   DateTime @updatedAt
}

model ImuteConfig {
	guildId     String   @id
	enabled     Boolean  @default(false)
	roleId      String?  // image mute role
	logChannelId String?
	createdAt   DateTime @default(now())
	updatedAt   DateTime @updatedAt
}

model RmuteConfig {
	guildId     String   @id
	enabled     Boolean  @default(false)
	roleId      String?  // reaction mute role
	logChannelId String?
	createdAt   DateTime @default(now())
	updatedAt   DateTime @updatedAt
}

model ModerationCase {
	id          String   @id @default(cuid())
	guildId     String
	caseNumber  Int
	type        String   // ban, kick, timeout, warn, jail, softban, hardban, strip, unban, unjail, imute, iunmute, rmute, runmute
	moderatorId String
	targetId    String
	reason      String?
	duration    Int?     // seconds for timeout/tempban
	createdAt   DateTime @default(now())

	@@unique([guildId, caseNumber])
	@@index([guildId, targetId])
	@@index([guildId, moderatorId])
}

model ModerationLog {
	id        String   @id @default(cuid())
	guildId   String
	caseId    String
	type      String   // dm_sent, message_sent, dm_failed, etc.
	content   String
	createdAt DateTime @default(now())

	@@index([guildId, caseId])
}
