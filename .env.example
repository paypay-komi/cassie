# Optional: pick the local Ollama model used by c.ai / c.chat (default qwen3.5:9b)
OLLAMA_MODEL=

# Toxicity automod filter (everything runs locally, no external API calls).
# Enable per server:  automod filter toxicity on [threshold%] [punishment]
# Default threshold is 90 and the default action is a warn; nothing is deleted
# unless you pass a punishment such as "delete".
# The first scored message downloads the ONNX model (Xenova/toxic-bert, ~110MB)
# once into the cache dir below; after that it works offline.
TOXICITY_CACHE_DIR=
TOXICITY_MODEL=
