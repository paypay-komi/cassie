# Hugging Face (optional). Never commit a real token.
# Create a fine-grained token with "Make calls to Inference Providers" at
# https://huggingface.co/settings/tokens
HF_TOKEN=

# Set to "hf" to run c.ai / c.chat on Hugging Face instead of local Ollama.
# Unset = existing Ollama behaviour.
AI_BACKEND=
# Chat model on the HF router (default meta-llama/Llama-3.1-8B-Instruct, gated: accept its license on HF first)
HF_CHAT_MODEL=
HF_CHAT_MAX_TOKENS=

# With HF_TOKEN set, the "toxicity" automod filter (unitary/toxic-bert) becomes available:
#   automod enable ...
#   automod filter toxicity on [threshold%] [punishment]
# Default threshold is 90 and the default action is a warn (nothing is deleted
# unless you pass a punishment such as "delete").
